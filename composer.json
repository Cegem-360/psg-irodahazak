{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "dcrepper/filament-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "erusev/parsedown": "^1.8.0",
        "filament/filament": "^5.11.2",
        "filament/spatie-laravel-media-library-plugin": "^5.11.2",
        "intervention/image": "^3.11.10",
        "laravel/framework": "^13.40",
        "laravel/tinker": "^3.0.2",
        "league/flysystem-ftp": "^3.36",
        "livewire/blaze": "^1.0.21",
        "livewire/livewire": "^4.4.8",
        "madbox-99/filament-essentials": "^2.0",
        "nunomaduro/essentials": "@dev",
        "phpoffice/phpspreadsheet": "^5.11",
        "spatie/browsershot": "^5.5.0",
        "spatie/image": "^3.9.10",
        "spatie/laravel-googletagmanager": "^3.1.1",
        "spatie/laravel-honeypot": "^4.7.3",
        "spatie/laravel-medialibrary": "^11.23.12",
        "spatie/laravel-sitemap": "^7.4.0",
        "whitecube/laravel-cookie-consent": "^1.3.10"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4.5",
        "barryvdh/laravel-ide-helper": "^3.8.0",
        "driftingly/rector-laravel": "^2.7.3",
        "fakerphp/faker": "^1.24.1",
        "filament/upgrade": "^5.11.2",
        "laravel/boost": "^2.10.4",
        "laravel/pail": "^1.2.7",
        "laravel/pint": "^1.32.1",
        "laravel/sail": "^1.69.0",
        "madbox-99/rector-filament": "^1.4.1",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^4.7.8",
        "pestphp/pest-plugin-faker": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-livewire": "^4.1",
        "rector/rector": "^2.8.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "rector": [
            "@php vendor/bin/rector process --ansi"
        ],
        "pint": [
            "@php vendor/bin/pint --test"
        ],
        "pint-fix": [
            "@php vendor/bin/pint"
        ],
        "fix": [
            "@rector",
            "@php vendor/bin/pint"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.4.27"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
